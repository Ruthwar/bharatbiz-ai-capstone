# Copy this file to .env; the app loads it automatically at import.
APP_MODE=mock
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_JSON_MODE=json_object
# Optional path to the CA bundle when the endpoint uses a private CA (for example the IIT gateway).
# vm05-ca.crt is committed; a relative path resolves from the directory you start the app in.
LLM_CA_BUNDLE=vm05-ca.crt
DATA_DIR=data/synthetic
# Local trace store for model and retrieval spans. Defaults to data/runtime/traces.sqlite3.
# BHARATBIZ_TRACE_DB=
# Cost is not priced unless you set an illustrative rate per 1,000 reported tokens.
# BHARATBIZ_TRACE_COST_PER_1K_TOKENS=
# Optional: also send spans to a Langfuse instance. Off unless all four values are set.
# BHARATBIZ_TRACE_EXPORT=langfuse
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
