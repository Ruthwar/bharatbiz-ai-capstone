# Copy this file to .env; the app loads it automatically at import.
APP_MODE=mock
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_JSON_MODE=json_object
# Optional path to the CA bundle when the endpoint uses a private CA (for example the IIT gateway).
LLM_CA_BUNDLE=
DATA_DIR=data/synthetic
